# Firebase web config — copy to `.env` and fill with your project's values.
# Find these in Firebase Console → Project settings → General → "Your apps" (Web).
# When these are set, the app enables Google sign-in and TRUE cross-device
# online Ludo (Firestore). Without them the app runs in guest/offline mode and
# online Ludo falls back to same-browser (local) play.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Fair (server-side) dealing for online Baloot. Set to 1 ONLY after deploying
# the dealBaloot Cloud Function (`firebase deploy --only functions`). The host
# then deals each round through the function, keeping every human's hand in a
# private doc only they can read. Leave blank to use the verified
# client-authoritative dealing.
VITE_FAIR_DEAL=
