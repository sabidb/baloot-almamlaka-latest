rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Admin access requires a custom claim set server-side (Admin SDK /
    // Cloud Function). The client-side PIN in AdminPanel.jsx is NOT
    // security — without this claim, admin writes are denied.
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function notBanned() { return !('banned' in resource.data) || resource.data.banned != true; }

    // A client may edit its own profile but must NOT be able to mint
    // currency or fake a record. coins may only go down (spending);
    // wins/losses/isVip are server-only. The referee (Cloud Functions via
    // Admin SDK) and admins bypass all of this.
    function noEconomyCheat() {
      let d = request.resource.data;
      let o = resource.data;
      return d.get('coins', 0) <= o.get('coins', 0)
        && d.get('wins', 0) == o.get('wins', 0)
        && d.get('losses', 0) == o.get('losses', 0)
        && d.get('isVip', false) == o.get('isVip', false)
        && d.get('banned', false) == o.get('banned', false);
    }

    match /users/{uid} {
      // Any signed-in player can read profiles (leaderboard, friend search)
      allow read: if signedIn();
      // New profiles start with at most the 500-coin welcome bonus and a
      // clean record — no self-granted VIP or inflated stats.
      allow create: if isSelf(uid)
        && request.resource.data.get('coins', 0) <= 500
        && request.resource.data.get('wins', 0) == 0
        && request.resource.data.get('losses', 0) == 0
        && request.resource.data.get('isVip', false) == false
        && request.resource.data.get('banned', false) == false;
      // Players edit their own doc (profile, spending, cosmetics) but the
      // economy fields are locked. Banned users cannot write.
      allow update: if (isSelf(uid) && notBanned() && noEconomyCheat()) || isAdmin();
      allow delete: if isAdmin();

      match /friends/{friendId} {
        allow read: if isSelf(uid);
        // The accepting user writes into BOTH friends subcollections
        // (their own and the requester's), so the counterparty must also
        // be allowed to write a doc keyed by their own uid.
        allow write: if isSelf(uid) || (signedIn() && request.auth.uid == friendId);
      }

      // Daily-mission progress: the referee (Cloud Functions, Admin SDK)
      // records games/wins here so it can't be forged, and pays out claims.
      // Clients may only read their own progress — never write it.
      match /missions/{day} {
        allow read: if isSelf(uid);
        allow write: if isAdmin();
      }
    }

    match /friendRequests/{id} {
      allow read: if signedIn() &&
        (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.from == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Only the recipient can accept/reject, and may only change status.
      allow update: if signedIn() &&
        resource.data.to == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.to == request.auth.uid;
      // Game invites are created by the sender addressed to someone else.
      allow create: if signedIn() && request.resource.data.to is string;
      // Recipient can mark as read.
      allow update: if signedIn() &&
        resource.data.to == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    match /tournaments/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      // MVP: any signed-in player can update (join flow rewrites the
      // players array from the client). This is NOT tamper-proof — move
      // joins/settlement to a Cloud Function before real prizes exist.
      allow update: if signedIn();
      allow delete: if isAdmin();
    }

    match /rooms/{code} {
      allow read, write: if signedIn();

      // Fair-dealing per-player hands, written ONLY by the dealBaloot Cloud
      // Function (the Admin SDK bypasses these rules). A player may read
      // only their own hand; clients can never write here.
      match /private/{uid} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    // Match telemetry: append-only from clients; only the anti-collusion
    // agent (Admin SDK, bypasses rules) and admins read it back.
    match /matches/{id} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Anti-collusion flags: written only by the scan agent (Admin SDK),
    // readable only by admins.
    match /flags/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything not matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
