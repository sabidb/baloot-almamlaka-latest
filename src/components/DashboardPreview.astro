---
// Placeholder for the RestoPos dashboard UI — pure markup, no data.
const kpis = [
  { label: "Today's sales", value: 'SAR 12,480', delta: '+8.2%' },
  { label: 'Orders', value: '342', delta: '+4.6%' },
  { label: 'Avg. ticket', value: 'SAR 36.50', delta: '+1.9%' },
];

const bars = [42, 58, 45, 70, 62, 84, 76, 92, 68, 88, 74, 96];

const orders = [
  { id: '#2841', table: 'Table 12', total: 'SAR 148.00', status: 'Preparing' },
  { id: '#2840', table: 'Takeaway', total: 'SAR 62.50', status: 'Ready' },
  { id: '#2839', table: 'Table 4', total: 'SAR 214.00', status: 'Served' },
];
---

<div
  role="img"
  aria-label="Preview of the RestoPos dashboard showing sales metrics, an hourly sales chart and live orders"
  class="overflow-hidden rounded-2xl bg-ink-950/90"
>
  <!-- Window chrome -->
  <div class="flex items-center gap-1.5 border-b border-white/5 px-4 py-3">
    <span class="size-2.5 rounded-full bg-white/15"></span>
    <span class="size-2.5 rounded-full bg-white/15"></span>
    <span class="size-2.5 rounded-full bg-white/15"></span>
    <span class="ml-3 text-[11px] font-medium tracking-wide text-white/30">
      RestoPos — Dashboard
    </span>
    <span
      class="ml-auto rounded-full border border-mint-500/25 bg-mint-500/10 px-2.5 py-0.5 text-[10px] font-semibold text-mint-300"
    >
      ● Live
    </span>
  </div>

  <div class="grid grid-cols-[3rem_1fr] sm:grid-cols-[3.5rem_1fr]">
    <!-- Sidebar -->
    <div class="flex flex-col items-center gap-3 border-r border-white/5 py-4">
      {
        [0, 1, 2, 3, 4].map((i) => (
          <span
            class:list={[
              'size-8 rounded-lg',
              i === 0 ? 'bg-gradient-to-br from-brand-400 to-brand-600' : 'bg-white/[0.06]',
            ]}
          />
        ))
      }
    </div>

    <!-- Main panel -->
    <div class="space-y-4 p-4 sm:p-5">
      <!-- KPI cards -->
      <div class="grid grid-cols-3 gap-3">
        {
          kpis.map(({ label, value, delta }) => (
            <div class="rounded-xl border border-white/5 bg-white/[0.03] p-3">
              <p class="text-[10px] font-medium uppercase tracking-wider text-white/35">{label}</p>
              <p class="mt-1 truncate font-display text-sm font-semibold text-white sm:text-lg">
                {value}
              </p>
              <p class="mt-0.5 text-[10px] font-semibold text-mint-400">{delta}</p>
            </div>
          ))
        }
      </div>

      <div class="grid gap-3 sm:grid-cols-5">
        <!-- Sales chart -->
        <div class="rounded-xl border border-white/5 bg-white/[0.03] p-3 sm:col-span-3">
          <p class="text-[10px] font-medium uppercase tracking-wider text-white/35">
            Sales by hour
          </p>
          <div class="mt-3 flex h-24 items-end gap-1.5">
            {
              bars.map((h, i) => (
                <span
                  class:list={[
                    'flex-1 rounded-t-sm',
                    i === bars.length - 1
                      ? 'bg-gradient-to-t from-brand-600 to-brand-400'
                      : 'bg-white/10',
                  ]}
                  style={`height:${h}%`}
                />
              ))
            }
          </div>
        </div>

        <!-- Live orders -->
        <div class="rounded-xl border border-white/5 bg-white/[0.03] p-3 sm:col-span-2">
          <p class="text-[10px] font-medium uppercase tracking-wider text-white/35">Live orders</p>
          <ul class="mt-2.5 space-y-2">
            {
              orders.map(({ id, table, total, status }) => (
                <li class="flex items-center justify-between rounded-lg bg-white/[0.03] px-2.5 py-2">
                  <div>
                    <p class="text-[11px] font-semibold text-white/80">
                      {id} · {table}
                    </p>
                    <p class="text-[10px] text-white/35">{total}</p>
                  </div>
                  <span
                    class:list={[
                      'rounded-full px-2 py-0.5 text-[9px] font-semibold',
                      status === 'Ready'
                        ? 'bg-mint-500/15 text-mint-300'
                        : status === 'Preparing'
                          ? 'bg-brand-500/15 text-brand-300'
                          : 'bg-white/10 text-white/50',
                    ]}
                  >
                    {status}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
