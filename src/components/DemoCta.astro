<section id="demo" class="px-4 pb-28 pt-8">
  <div
    class="light-sweep relative mx-auto max-w-4xl overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-b from-ink-800 to-ink-900 px-6 py-16 text-center shadow-[inset_0_1px_0_rgba(255,255,255,0.08)] sm:px-12"
  >
    <h2 class="font-display text-3xl font-bold tracking-tight text-white sm:text-4xl">
      See RestoPos in your restaurant
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-white/60">
      A 20-minute walkthrough with our team — your menu, your workflow, live ZATCA e-invoicing.
    </p>
    <form
      class="mx-auto mt-9 flex max-w-md flex-col gap-3 sm:flex-row"
      action="mailto:sales@restopos.example"
      method="get"
    >
      <label class="sr-only" for="demo-email">Work email</label>
      <input
        id="demo-email"
        type="email"
        name="email"
        required
        placeholder="you@restaurant.sa"
        class="w-full rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm text-white placeholder:text-white/35 focus:border-brand-400/60 focus:outline-none"
      />
      <button
        type="submit"
        class="shrink-0 rounded-full bg-gradient-to-b from-brand-400 to-brand-600 px-7 py-3 text-sm font-semibold text-ink-950 shadow-[0_8px_24px_rgba(245,158,11,0.35)] transition hover:brightness-110"
      >
        Book Demo
      </button>
    </form>
  </div>
</section>
